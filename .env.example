# Environment Variables for Stripe Integration

# ========================================
# STRIPE API KEYS
# ========================================
# Get these from: https://dashboard.stripe.com/test/apikeys

# PUBLIC KEY (safe to expose in client-side code)
# This key starts with 'pk_test_' for test mode or 'pk_live_' for production
VITE_STRIPE_PUBLIC_KEY=pk_test_YOUR_KEY_HERE

# SECRET KEY (NEVER expose this - server-side only)
# This key starts with 'sk_test_' for test mode or 'sk_live_' for production  
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE

# WEBHOOK SECRET (for verifying webhook signatures)
# Get this from: Stripe Dashboard → Developers → Webhooks
# This starts with 'whsec_'
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# ========================================
# STRIPE PRODUCT/PRICE IDs
# ========================================
# Create products in Stripe Dashboard → Products
# Copy the price IDs (start with 'price_')

# Pro Monthly Subscription ($9.99/month)
VITE_STRIPE_PRICE_MONTHLY=price_YOUR_MONTHLY_PRICE_ID

# Pro Yearly Subscription ($89.99/year)
VITE_STRIPE_PRICE_YEARLY=price_YOUR_YEARLY_PRICE_ID

# ========================================
# SUPABASE KEYS (if not already set)
# ========================================
# Get these from: Supabase Dashboard → Project Settings → API

# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ========================================
# OPENAI API KEY (if not already set)
# ========================================
# Get this from: https://platform.openai.com/api-keys

# VITE_OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
