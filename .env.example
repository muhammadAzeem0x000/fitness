# Environment Variables for RevenueCat Integration

# ========================================
# REVENUECAT API KEY
# ========================================
# Get this from: RevenueCat Dashboard -> Project -> API Keys -> Public app-specific API key for Android
VITE_REVENUECAT_API_KEY=your_revenuecat_public_api_key

# ========================================
# SUPABASE KEYS (if not already set)
# ========================================
# Get these from: Supabase Dashboard → Project Settings → API

# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_ANON_KEY=your_anon_key_here
# SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here

# ========================================
# OPENAI API KEY (if not already set)
# ========================================
# Get this from: https://platform.openai.com/api-keys

# VITE_OPENAI_API_KEY=sk-YOUR_OPENAI_KEY_HERE
